{
  "framework": "vite",
  "installCommand": "pnpm install",
  "buildCommand": "pnpm run build:static",
  "outputDirectory": "dist/public",
  "redirects": [
    {
      "source": "/ai-proposal-generator",
      "destination": "/proposal-generator",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}